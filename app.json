{
  "expo": {
    "name": "Дай в долг",
    "slug": "zaymy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zaymy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5C518"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaymy.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению нужен доступ к камере для добавления фото подтверждений.",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к фотогалерее.",
        "NSContactsUsageDescription": "Приложению нужен доступ к контактам для быстрого заполнения данных."
      }
    },
    "android": {
      "package": "com.zaymy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5C518"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
